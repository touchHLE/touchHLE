<!-- Paths the FileProvider declared in AndroidManifest.xml is allowed to share.
     The in-app updater stages the downloaded APK in the app's external files
     directory (getExternalFilesDir(null), which is also what SDL's
     SDL_AndroidGetExternalStoragePath returns), so that path must be covered. -->
<paths>
    <external-files-path
        name="update"
        path="." />
</paths>
