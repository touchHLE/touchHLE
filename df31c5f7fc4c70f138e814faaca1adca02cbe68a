      "message": "Would change to this to support messages where log is the same, but values change:\n\n/// Like [log], but prints the message only once when duplicates are detected.\n/// To be used for log messages that are known to spam the log file (like those\n/// logged every frame). If a formatted message is sent, it will only log the \n/// first instance even if the actual values change.\n#[macro_export]\nmacro_rules! log_once {\n    ($fmt:literal $(, $arg:expr)* $(,)?) \u003d\u003e {{\n        let key \u003d $fmt.to_string();\n        let mut set \u003d $crate::log::LOGGED_MESSAGES.lock().unwrap();\n        if set.insert(key) {\n            log!($fmt $(, $arg)*);\n        }\n    }};\n}",
